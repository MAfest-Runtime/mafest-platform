[Unit]
Description=Block Tailscale UDP to/from the Pod CIDR (path-flap guard)
# 부팅 때 tailscaled가 탐색을 시작하기 전에 규칙이 먼저 있어야 한다.
After=network-pre.target
Before=network.target tailscaled.service
Wants=network-pre.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/sbin/nft -f /etc/tailscale-podcidr-guard/rules.nft
ExecReload=/usr/sbin/nft -f /etc/tailscale-podcidr-guard/rules.nft
# 테이블이 없어도 중지가 실패하지 않게 `-`를 둔다.
ExecStop=-/usr/sbin/nft delete table inet tailscale_podcidr_guard

[Install]
WantedBy=multi-user.target
