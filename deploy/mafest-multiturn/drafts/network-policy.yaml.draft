# [초안·비활성] 새 워크로드 전용 NetworkPolicy. 기존 mafest-allow-db-ingress 와 default-deny 는 바꾸지 않는다.
# 기존 정책은 라벨 mafest-api·mafest-loader 만 5432를 연다. 새 Job은 자기 라벨에 맞는 정책만 추가한다.
#
# 짝 규칙(scripts/check-mafest-multiturn-prep.sh 가 검사): 워크로드마다 egress 정책(DNS + DB)과
# DB 쪽 ingress 정책이 하나씩 있어야 한다.
---
# 마이그레이션 Job(mafest-data) → DB. 같은 namespace 안이므로 podSelector만 쓴다.
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: mafest-allow-migrate-egress
  namespace: mafest-data
  labels:
    app.kubernetes.io/part-of: persona-platform
    app.kubernetes.io/component: networkpolicy
spec:
  podSelector:
    matchLabels:
      app.kubernetes.io/name: mafest-session-migrate
  policyTypes:
    - Egress
  egress:
    - to:
        - namespaceSelector:
            matchLabels:
              kubernetes.io/metadata.name: kube-system
          podSelector:
            matchLabels:
              k8s-app: kube-dns
      ports:
        - protocol: UDP
          port: 53
        - protocol: TCP
          port: 53
    - to:
        - podSelector:
            matchLabels:
              cnpg.io/cluster: mafest-db
      ports:
        - protocol: TCP
          port: 5432
---
# DB가 받는 쪽: 마이그레이션 Job과 정리 CronJob만 추가로 5432를 허용한다.
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: mafest-allow-db-ingress-session-jobs
  namespace: mafest-data
  labels:
    app.kubernetes.io/part-of: persona-platform
    app.kubernetes.io/component: networkpolicy
spec:
  podSelector:
    matchLabels:
      cnpg.io/cluster: mafest-db
  policyTypes:
    - Ingress
  ingress:
    - from:
        - podSelector:
            matchLabels:
              app.kubernetes.io/name: mafest-session-migrate
        - namespaceSelector:
            matchLabels:
              kubernetes.io/metadata.name: mafest-app
          podSelector:
            matchLabels:
              app.kubernetes.io/name: mafest-session-cleanup
      ports:
        - protocol: TCP
          port: 5432
---
# 정리 CronJob(mafest-app) → DNS, mafest-data의 DB.
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: mafest-allow-cleanup-egress
  namespace: mafest-app
  labels:
    app.kubernetes.io/part-of: persona-platform
    app.kubernetes.io/component: networkpolicy
spec:
  podSelector:
    matchLabels:
      app.kubernetes.io/name: mafest-session-cleanup
  policyTypes:
    - Egress
  egress:
    - to:
        - namespaceSelector:
            matchLabels:
              kubernetes.io/metadata.name: kube-system
          podSelector:
            matchLabels:
              k8s-app: kube-dns
      ports:
        - protocol: UDP
          port: 53
        - protocol: TCP
          port: 53
    - to:
        - namespaceSelector:
            matchLabels:
              kubernetes.io/metadata.name: mafest-data
          podSelector:
            matchLabels:
              cnpg.io/cluster: mafest-db
      ports:
        - protocol: TCP
          port: 5432
